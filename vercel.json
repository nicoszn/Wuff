{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "services": {
    "frontend-app": {
      "root": "."
    },
    "downloader-api": {
      "root": "downloader-service/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { 
      "source": "/api/downloader", 
      "destination": { "service": "downloader-api" } 
    },
    { 
      "source": "/(.*)", 
      "destination": { "service": "frontend-app" } 
    }
  ]
}
