# Public site URL, used for canonical/OG tags in metadata
NEXT_PUBLIC_SITE_URL=https://yourapp.com

# Google AdSense publisher ID (Account > Account information)
# Leave unset in local dev — AdSlot renders a labeled placeholder instead.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Ad unit ("slot") IDs — create these in AdSense > Ads > By ad unit.
# One per placement so each can be sized/targeted independently.
NEXT_PUBLIC_AD_SLOT_HOME_TOP=0000000001
NEXT_PUBLIC_AD_SLOT_HOME_MID=0000000002
NEXT_PUBLIC_AD_SLOT_CLONE_INLINE=0000000003
NEXT_PUBLIC_AD_SLOT_CLONE_FAQ=0000000004
NEXT_PUBLIC_AD_SLOT_DESIGN_INLINE=0000000005
NEXT_PUBLIC_AD_SLOT_DESIGN_FAQ=0000000006
