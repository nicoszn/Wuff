FROM python:3.12-slim

# Install system dependencies including FFmpeg needed by yt-dlp
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /lib/apt/lists/*

WORKDIR /app

# Copy python dependencies list and install them
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend script source code into image space
COPY . .

# Vercel containers MUST bind dynamically to the assigned $PORT variable environment
EXPOSE 8000
ENV PORT=8000

# Fire up Uvicorn binding explicitly to the dynamic network port hook
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port $PORT"]
